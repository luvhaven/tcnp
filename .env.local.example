# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=replace_with_a_long_random_secret

# Map Configuration (Optional - defaults to OpenStreetMap)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_optional
# Create a free developer key at developer.tomtom.com. This is server-only:
# never prefix it with NEXT_PUBLIC_ or expose it in browser code.
TOMTOM_API_KEY=your_free_tomtom_api_key_optional

# Notification Providers (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@tcnp.org

TWILIO_ACCOUNT_SID=your_twilio_sid_optional
TWILIO_AUTH_TOKEN=your_twilio_token_optional
TWILIO_PHONE_NUMBER=your_twilio_phone_optional

# Flight Tracking API (Optional; enables authenticated OpenSky quota for Command flight map)
OPENSKY_CLIENT_ID=your_opensky_oauth_client_id_optional
OPENSKY_CLIENT_SECRET=your_opensky_oauth_client_secret_optional

# ─── Error Monitoring (Sentry) ───────────────────────────────────────────────
# Leave the DSN blank and the SDK stays completely inert: no network calls,
# no overhead. Nothing breaks without it.
#
# Get the DSN from Sentry > Settings > Projects > <project> > Client Keys (DSN).
# This one is public by design (it only allows writing events, not reading).
NEXT_PUBLIC_SENTRY_DSN=
# Optional: separate DSN for server/edge events. Defaults to the public one.
SENTRY_DSN=

# Source map upload at build time. Without these, production stack traces stay
# minified and point at anonymous bundle offsets instead of real file:line.
# Create the token at Sentry > Settings > Auth Tokens with scopes
# project:releases and org:read. SERVER-ONLY — never prefix with NEXT_PUBLIC_.
SENTRY_ORG=your_sentry_org_slug
SENTRY_PROJECT=your_sentry_project_slug
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Optional tuning. Both default to 0.1 (10% of requests traced for performance).
# Errors are always captured at 100% regardless of these.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional: override the environment label shown in Sentry (defaults to
# VERCEL_ENV, then NODE_ENV).
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Set to true to print SDK activity (dropped/filtered events, transport
# failures) to the console. Use when events are not arriving. Never in prod.
# The server/edge runtimes read SENTRY_DEBUG; the browser needs the
# NEXT_PUBLIC_ copy because unprefixed vars are not sent to the client.
SENTRY_DEBUG=false
NEXT_PUBLIC_SENTRY_DEBUG=false
